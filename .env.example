# ══════════════════════════════════════════════════════════════════════
# HEALTH NET — Variables de entorno
# Copia este archivo como .env y llena los valores con tu configuración AWS
# ══════════════════════════════════════════════════════════════════════

# Región AWS (ej. us-west-1, us-west-2, us-east-1)
VITE_AWS_REGION=us-west-1

# ── Cognito ──────────────────────────────────────────────────────────
# User Pool ID  (ej. us-west-1_AbCdEfGhI)
VITE_COGNITO_USER_POOL_ID=

# App Client ID del User Pool (sin secret)
VITE_COGNITO_CLIENT_ID=

# Identity Pool ID para credenciales IoT (ej. us-west-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_COGNITO_IDENTITY_POOL_ID=

# ── AWS IoT Core ─────────────────────────────────────────────────────
# Endpoint de IoT Core (sin https://, sin /mqtt)
# Encuéntralo en: IoT Core → Settings → Device data endpoint
# Formato: xxxxxxxxxxxxxx-ats.iot.us-west-1.amazonaws.com
VITE_IOT_ENDPOINT=

# ══════════════════════════════════════════════════════════════════════
# Sin estas variables el proyecto corre en MODO DEMO local.
# Los datos se simulan sin conexión real a AWS.
# ══════════════════════════════════════════════════════════════════════

